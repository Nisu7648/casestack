# ============================================
# CASESTACK PRODUCTION ENVIRONMENT
# ============================================

# Database
DATABASE_URL=postgresql://username:password@host:5432/casestack_production

# JWT Secret (MUST be strong and unique)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Server
NODE_ENV=production
PORT=5000
HOST=0.0.0.0

# CORS (Set to your frontend domain)
CORS_ORIGIN=https://your-domain.com

# Storage
STORAGE_TYPE=s3
# For local storage: STORAGE_TYPE=local
# For S3: STORAGE_TYPE=s3

# AWS S3 (if using S3 storage)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=casestack-files

# Email (Optional - for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@casestack.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload
MAX_FILE_SIZE=52428800
# 50MB = 52428800 bytes

# Session
SESSION_SECRET=your-session-secret-change-this

# Logging
LOG_LEVEL=info
# Options: error, warn, info, debug

# Security
HELMET_ENABLED=true
COMPRESSION_ENABLED=true

# Device Management
MAX_DEVICES_PER_USER=3

# Archive Settings
ARCHIVE_AFTER_DAYS=2555
# 7 years = 2555 days

# Backup (Optional)
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
# Daily at 2 AM

# Monitoring (Optional)
SENTRY_DSN=your-sentry-dsn
NEW_RELIC_LICENSE_KEY=your-newrelic-key

# Feature Flags
ENABLE_ANALYTICS=true
ENABLE_NOTIFICATIONS=true
ENABLE_EXPORTS=true
